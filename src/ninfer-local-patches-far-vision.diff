+// Far-key attention (a.far_splits > 0): rows in groups of kFarRows. A group's far keys [0, floor)
+// are those every row of it sees at a distance of at least the bias table's extent, whole tiles;
+// none when the group's rows belong to different sequences. A prompt chunk's floor also stays below
+// its first row (r.first): earlier keys are the cache's, at their logical positions and seen by
+// every row of the chunk, while the chunk's own keys keep their masks. The near kernel starts its
+// rows at the floor and the far kernel covers the rest.
+constexpr int kFarRows = 8;
+
+__device__ __forceinline__ int far_floor(const AttentionArgs& a, int t) {
+    if (a.far_splits == 0) { return 0; }
+    const int r0 = t / kFarRows * kFarRows, r1 = min(a.rows.tokens, r0 + kFarRows);
+    const int sequence = row_sequence(a.rows, r0);
+    int f = a.rows.chunk ? a.rows.first : INT_MAX;
+    for (int r = r0; r < r1; ++r) {
+        if (row_sequence(a.rows, r) != sequence) { return 0; }
+        f = min(f, a.rows.positions[r] - max(a.extent, 1) + 1);
+    }
+    return max(0, f) / kTile * kTile;
