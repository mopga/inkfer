From a9df5bf66958d80a421bf58c8bbc542e5529da3c Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Sun, 22 Nov 2026 05:56:21 +0300
Subject: [PATCH 4/6] fix(inkling2): the host store drops images a newer image
 of the same conversation supersedes before the last image of another

A conversation leaves an image at every request (the state at its prompt's end and after its answer). With two
conversations taking turns, a few requests of one in a row filled the store with its own images and the
least-recently-used rule dropped every image of the other: its next prompt was read again from the start
(185,156 tokens, 4 min 5 s in an agent run with a subagent). make_host_room now drops first the images that a
newer image, or the incoming one, continues (7/8 of the tokens shared, at most twice as long), then the least
recently used; it reports when it has to drop the last image of a conversation.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/runtime/engine/inkling2_core.cpp | 65 +++++++++++++++++++++++-----
 1 file changed, 55 insertions(+), 10 deletions(-)

diff --git a/src/runtime/engine/inkling2_core.cpp b/src/runtime/engine/inkling2_core.cpp
index 634e75f..37d4e34 100644
--- a/src/runtime/engine/inkling2_core.cpp
+++ b/src/runtime/engine/inkling2_core.cpp
@@ -1136,21 +1136,66 @@ struct Inkling2Core::Impl {
         return static_cast<std::uint32_t>(held.size());
     }
 
-    // Frees pages for an image of `bytes`, dropping the least recently used images; false when
-    // the budget cannot hold it at all, or only by dropping an image a prompt is resuming from.
-    bool make_host_room(std::uint64_t bytes) {
+    // Whether the store can do without `image`: a newer image, or the one coming in, holds the
+    // same conversation further on - it shares at least 7/8 of this image's tokens and is at
+    // most twice as long. A conversation leaves such images at every request (the state at its
+    // prompt's end, and after its answer); a prompt that needs an older one resumes from the
+    // newer one's trail points. The newest image of a conversation is never superseded, and
+    // neither is a short shared prefix (a system prompt) by the conversations that begin with it.
+    [[nodiscard]] bool superseded(const Stored& image, const std::vector<TokenId>* incoming) const {
+        if (!image.media.empty()) { return false; }
+        const auto& mine    = image.tokens;
+        const auto follows = [&mine](const std::vector<TokenId>& other) {
+            if (other.size() > 2 * mine.size()) { return false; }
+            const std::size_t most = std::min(mine.size(), other.size());
+            const auto common      = static_cast<std::size_t>(
+                std::mismatch(mine.begin(), mine.begin() + static_cast<std::ptrdiff_t>(most),
+                              other.begin())
+                    .first -
+                mine.begin());
+            return common >= mine.size() - mine.size() / 8;
+        };
+        if (incoming != nullptr && follows(*incoming)) { return true; }
+        for (const Stored& other : stored) {
+            if (&other != &image && other.media.empty() && other.last_used > image.last_used &&
+                follows(other.tokens)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // Frees pages for an image of `bytes` (of `incoming` tokens), dropping first the least
+    // recently used images another image supersedes, then the least recently used ones: a
+    // conversation that makes many requests in a row replaces its own images, not the only
+    // image of the conversation it takes turns with. False when the budget cannot hold the image
+    // at all, or only by dropping an image a prompt is resuming from.
+    bool make_host_room(std::uint64_t bytes, const std::vector<TokenId>* incoming = nullptr) {
         const std::size_t pages = static_cast<std::size_t>((bytes + kHostPageBytes - 1) / kHostPageBytes);
         if (pages > host_budget / kHostPageBytes) { return false; }
         while (free_pages.size() < pages) {
-            auto oldest = stored.end();
+            auto victim = stored.end();
+            bool spare  = false;
             for (auto image = stored.begin(); image != stored.end(); ++image) {
                 if (image->held) { continue; }
-                if (oldest == stored.end() || image->last_used < oldest->last_used) { oldest = image; }
+                const bool redundant = superseded(*image, incoming);
+                if (victim == stored.end() || (redundant && !spare) ||
+                    (redundant == spare && image->last_used < victim->last_used)) {
+                    victim = image;
+                    spare  = redundant;
+                }
+            }
+            if (victim == stored.end()) { return false; }
+            if (!spare && victim->tokens.size() >= 16384) { // not a shared system prompt
+                std::fprintf(stderr,
+                             "Inkling 2: host store full, dropped the last state of a conversation "
+                             "(%zu tokens, %.0f MiB); a larger --host-cache-mib keeps more of them\n",
+                             victim->tokens.size(), double(victim->bytes) / 1048576.0);
+                std::fflush(stderr);
             }
-            if (oldest == stored.end()) { return false; }
-            free_pages.insert(free_pages.end(), oldest->pages.begin(), oldest->pages.end());
-            host_used -= oldest->pages.size() * kHostPageBytes;
-            stored.erase(oldest);
+            free_pages.insert(free_pages.end(), victim->pages.begin(), victim->pages.end());
+            host_used -= victim->pages.size() * kHostPageBytes;
+            stored.erase(victim);
         }
         return true;
     }
@@ -1202,7 +1247,7 @@ struct Inkling2Core::Impl {
         const auto position = at != nullptr ? at->position : executor.position(s);
         if (position != tokens.size()) { return; } // the state holds other tokens
         const std::uint64_t bytes = executor.image_bytes(position);
-        if (!make_host_room(bytes)) { return; }
+        if (!make_host_room(bytes, &tokens)) { return; }
         Stored image;
         image.tokens = tokens;
         image.media  = media;
-- 
