+    // The trail points whose tokens `tokens` starts with, none past `limit`: indexes, ascending.
+    [[nodiscard]] std::vector<std::size_t> trail_matches(const std::vector<TokenId>& tokens,
+                                                         std::size_t limit) const {
+        std::vector<std::size_t> out;
+        TrailHash hash;
+        std::size_t at = 0;
+        limit          = std::min(limit, tokens.size());
+        for (std::size_t i = 0; i < trail.size(); ++i) {
+            const std::size_t position = trail[i]->position;
+            if (position > limit) { break; }
+            for (; at < position; ++at) { hash.feed(tokens[at]); }
+            if (hash.a == trail[i]->hash_a && hash.b == trail[i]->hash_b) { out.push_back(i); }
+        }
+        return out;
+    }
+
+    // After a prompt step: a point at the sequence's end, once it lies a grid past the last one of
+    // its tokens. With the trail full, the oldest point of other tokens goes, else the one of
+    // these tokens whose neighbours lie closest.
+    void take_trail_point(std::uint32_t s) {
+        Slot& slot = slots[s];
+        if (trail_grid == 0 || !slot.media.empty()) { return; }
+        const std::size_t n = slot.fed.size();
+        if (n < trail_grid || n < slot.trail_next) { return; }
+        auto& executor = *instance.executor;
+        if (executor.position(s) != n) { return; }
+        const auto own         = trail_matches(slot.fed, n);
+        const std::size_t last = own.empty() ? 0 : trail[own.back()]->position;
+        slot.trail_next        = last + trail_grid;
+        if (n < slot.trail_next) { return; }
+        if (trail.size() >= trail_max_points) {
+            std::vector<char> mine(trail.size(), 0);
+            for (const std::size_t i : own) { mine[i] = 1; }
+            std::optional<std::size_t> victim;
+            for (std::size_t i = 0; i < trail.size(); ++i) {
+                if (mine[i] == 0 && (!victim || trail[i]->born < trail[*victim]->born)) { victim = i; }
+            }
+            if (!victim) {
+                std::size_t closest = 0;
+                for (std::size_t k = 0; k < own.size(); ++k) {
+                    const std::size_t before = k == 0 ? 0 : trail[own[k - 1]]->position;
+                    const std::size_t after  = k + 1 < own.size() ? trail[own[k + 1]]->position : n;
+                    if (!victim || after - before < closest) {
+                        closest = after - before;
+                        victim  = own[k];
+                    }
+                }
+            }
+            if (!victim) { return; }
+            trail.erase(trail.begin() + static_cast<std::ptrdiff_t>(*victim));
+        }
+        auto point = std::make_unique<TrailPoint>();
+        try {
+            point->rings = std::make_unique_for_overwrite<std::byte[]>(trail_ring_bytes);
+        } catch (const std::bad_alloc&) { return; }
+        TrailHash hash;
+        for (const TokenId token : slot.fed) { hash.feed(token); }
+        point->position = static_cast<std::uint32_t>(n);
+        point->hash_a   = hash.a;
+        point->hash_b   = hash.b;
+        point->born     = ++use_clock;
+        executor.save_rings(s, point->rings.get(), trail_ring_bytes);
+        const auto at = std::upper_bound(
+            trail.begin(), trail.end(), point->position,
+            [](std::uint32_t position, const std::unique_ptr<TrailPoint>& held) {
+                return position < held->position;
+            });
+        trail.insert(at, std::move(point));
+        slot.trail_next = n + trail_grid;
+    }
+
+    // The furthest trail point a text prompt can resume from: one of the prompt's own tokens,
+    // below a position up to which the sequence (first) or a stored image holds those tokens.
+    [[nodiscard]] TrailPick pick_trail(const Slot& slot, std::uint32_t s, const Request& r) const {
+        if (trail.empty() || !r.media.empty() || r.branches || r.prompt_tokens.size() < 2) { return {}; }
+        const auto& tokens = r.prompt_tokens;
+        const auto matches = trail_matches(tokens, tokens.size() - 1);
+        if (matches.empty()) { return {}; }
+        const auto common = [&](const std::vector<TokenId>& held) {
+            const std::size_t n = std::min(held.size(), tokens.size());
+            return static_cast<std::size_t>(
+                std::mismatch(held.begin(), held.begin() + static_cast<std::ptrdiff_t>(n), tokens.begin())
+                    .first -
+                held.begin());
+        };
+        const std::size_t live =
+            slot.media.empty()
+                ? std::min<std::size_t>(common(slot.fed), instance.executor->position(s))
+                : 0;
+        std::size_t kept = 0;
+        std::optional<std::size_t> image;
+        for (std::size_t i = 0; i < stored.size(); ++i) {
+            if (!stored[i].media.empty() || stored[i].header.position != stored[i].tokens.size()) {
+                continue;
+            }
+            const std::size_t held = common(stored[i].tokens);
+            if (held > kept) {
+                kept  = held;
+                image = i;
+            }
+        }
+        for (auto it = matches.rbegin(); it != matches.rend(); ++it) {
+            const TrailPoint* point = trail[*it].get();
+            if (point->position <= live) { return {point, std::nullopt}; }
+            if (point->position <= kept) { return {point, image}; }
+        }
+        return {};
+    }
+
+    // Takes sequence `s` back to the picked trail point: its own tokens, or the stored image's,
+    // cut at the point. False when the image could not be brought in (the sequence keeps its state).
+    bool resume_from_trail(std::uint32_t s, const TrailPick& pick) {
+        Slot& slot             = slots[s];
+        auto& executor         = *instance.executor;
+        const std::uint32_t at = pick.point->position;
+        if (pick.image) {
+            std::vector<TokenId> tokens  = stored[*pick.image].tokens;
+            std::vector<MediaMark> media = stored[*pick.image].media;
+            stored[*pick.image].held     = true;
+            const auto release = [this] {
+                for (Stored& kept : stored) { kept.held = false; }
+            };
+            try {
+                retire(s);
+            } catch (...) {
+                release();
+                throw;
+            }
+            release();
+            const auto index = stored_index(tokens, media);
+            if (!index) { return false; }
+            restore_stored(s, *index);
+            slot.fed   = std::move(tokens);
+            slot.media = std::move(media);
+        } else {
+            retire(s);
+        }
+        executor.load_rings(s, at, pick.point->rings.get(), trail_ring_bytes);
+        slot.fed.resize(at);
+        slot.anchor.clear();
+        slot.anchor_media.clear();
+        trail_used_count += 1;
+        return true;
+    }
+
     [[nodiscard]] std::uint32_t reuse(const Slot& slot, const Request& prompt) const {
         if (!reuse_prefixes) { return 0; }
         return std::max(prefix_reuse(slot.fed, slot.media, prompt),
@@ -1251,7 +1454,13 @@ struct Inkling2Core::Impl {
             const std::uint32_t live       = prefix_reuse(slot.fed, slot.media, r);
             const std::uint32_t anchored   = prefix_reuse(slot.anchor, slot.anchor_media, r);
             const auto [image, from_store] = find_stored(r);
-            if (from_store > std::max(live, anchored)) {
+            const TrailPick pick           = pick_trail(slot, s, r);
+            if (pick.point != nullptr &&
+                pick.point->position > std::max({live, anchored, from_store}) + kTrailMargin &&
+                resume_from_trail(s, pick)) {
+                reused       = pick.point->position;
+                r.reuse_path = PrefixReusePath::PrivateLongAnchor;
+            } else if (from_store > std::max(live, anchored)) {
                 std::vector<TokenId> tokens  = stored[image].tokens;
                 std::vector<MediaMark> media = stored[image].media;
                 const PrefixReusePath path   = stored[image].path;
@@ -1303,6 +1512,7 @@ struct Inkling2Core::Impl {
         slot.request    = request;
         slot.last_used  = ++use_clock;
         slot.disposable = r.disposable;
+        slot.trail_next = 0;
         r.reused = r.prefilled = reused;
         if (drafts > 0) {
             r.speculative.enabled      = true;
@@ -1703,6 +1913,7 @@ struct Inkling2Core::Impl {
             slot.anchor       = slot.fed;
             slot.anchor_media = slot.media;
         }
+        if (reuse_prefixes && r.reusable) { take_trail_point(r.slot); }
         if (r.observation.prompt_progress) {
