+    // ---- Trail points (local patch) ---------------------------------------------------------------
+    // A sequence resumes only from a state that is a whole prefix of the new prompt (its live end,
+    // its anchor, a stored image). A prompt that parts from what the sequence holds somewhere in
+    // the middle (a client that renders an earlier message differently after a restart, an edited
+    // turn) would compute everything again. A trail point is the sequence's rings at a position,
+    // in pageable host memory, taken every `trail_grid` tokens of a prompt: the full-attention
+    // rows below a position are only appended to, so the rings are all it takes to go back there.
+    // A point serves a prompt that starts with the point's tokens (by hash) when a sequence, or a
+    // stored image, still holds those tokens (compared exactly).
+    struct TrailPoint {
+        std::uint32_t position = 0;
+        std::uint64_t hash_a = 0, hash_b = 0;
+        std::unique_ptr<std::byte[]> rings;
+        std::uint64_t born = 0;
+    };
+    struct TrailHash {
+        std::uint64_t a = 0xcbf29ce484222325ULL, b = 0x9e3779b97f4a7c15ULL;
+        void feed(TokenId token) {
+            const auto t = std::uint64_t(std::uint32_t(token));
+            a            = (a ^ t) * 0x100000001b3ULL;
+            b            = std::rotl(b, 23) * 0xff51afd7ed558ccdULL + t + 1;
+        }
+    };
+    struct TrailPick {
+        const TrailPoint* point = nullptr;
+        std::optional<std::size_t> image; // the stored image that holds its tokens; else the sequence
+    };
+    // A prompt resumes from a point only when that saves this many tokens over the whole prefixes.
+    static constexpr std::uint32_t kTrailMargin = 1024;
+    std::vector<std::unique_ptr<TrailPoint>> trail; // by position, ascending
+    std::uint32_t trail_grid       = 0;             // 0: no trail
+    std::uint64_t trail_ring_bytes = 0;
+    std::size_t trail_max_points   = 0;
+    std::uint64_t trail_used_count = 0;
     std::uint32_t decode_run                = 0;
     std::uint32_t decode_rounds_per_prefill = 1;
 
