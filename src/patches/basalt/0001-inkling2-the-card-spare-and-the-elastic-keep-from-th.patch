+// src/models/inkling2/ink.cpp - the BASALT_INK_* experiments' settings. Read the header first.
+#include "models/inkling2/ink.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+
+namespace basalt::models::inkling2::ink {
+
+long long env_int(const char* name, long long def, long long lo, long long hi) {
+    const char* s = std::getenv(name);
+    if (!s || !*s) return def;
+    char* end = nullptr;
+    const long long v = std::strtoll(s, &end, 10);
+    if (end == s) return def;
+    return std::clamp(v, lo, hi);
+}
+
+double env_real(const char* name, double def, double lo, double hi) {
+    const char* s = std::getenv(name);
+    if (!s || !*s) return def;
+    char* end = nullptr;
+    const double v = std::strtod(s, &end);
+    if (end == s || !(v == v)) return def;
+    return std::clamp(v, lo, hi);
+}
+
+std::string env_text(const char* name) {
+    const char* s = std::getenv(name);
+    return s ? std::string(s) : std::string();
+}
+
+const Reserves& reserves() {
+    static const Reserves r = [] {
+        Reserves v;
+        const auto mib = [&](const char* name, uint64_t& bytes) {
+            const long long def = (long long) (bytes >> 20);
+            const long long got = env_int(name, def, 0, 65536);
+            if (got != def) v.custom = true;
+            bytes = (uint64_t) got << 20;
+        };
+        mib("BASALT_INK_CARD_SPARE_MIB", v.card_spare);
+        mib("BASALT_INK_ELASTIC_KEEP_MIB", v.elastic_keep);
+        mib("BASALT_INK_SESSION_FIXED_MIB", v.session_fixed);
+        mib("BASALT_INK_SPILL_MARGIN_MIB", v.spill_margin);
+        return v;
+    }();
+    return r;
+}
+
+}  // namespace basalt::models::inkling2::ink
diff --git a/src/models/inkling2/ink.hpp b/src/models/inkling2/ink.hpp
new file mode 100644
index 0000000..993f846
--- /dev/null
+++ b/src/models/inkling2/ink.hpp
@@ -0,0 +1,33 @@
+// src/models/inkling2/ink.hpp - experiments on the on-card expert set of Inkling 2, each switched by an environment
+// variable (BASALT_INK_*) read once at first use. With none set the engine behaves as it does without this file.
+//
+//   BASALT_INK_CARD_SPARE_MIB     the card's spare the context plan keeps free and the elastic spill's first copy-back
+//                                 leaves (default 1024)
+//   BASALT_INK_ELASTIC_KEEP_MIB   free bytes an elastic KV grow leaves, and a restart's copy-back (default 512)
+//   BASALT_INK_SESSION_FIXED_MIB  what the plan counts for a session beside its caches (default 768)
+//   BASALT_INK_SPILL_MARGIN_MIB   the plan's margin when experts leave the card (default 128)
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace basalt::models::inkling2::ink {
+
+/// The integer in `name`, clamped to lo..hi; `def` when it is unset, empty or not a number.
+long long env_int(const char* name, long long def, long long lo, long long hi);
+/// The same for a real number.
+double env_real(const char* name, double def, double lo, double hi);
+/// The text in `name` (empty: unset).
+std::string env_text(const char* name);
+
+/// The memory reserves of the context plan and the elastic spill, in bytes.
+struct Reserves {
+    uint64_t card_spare = 1024ull << 20;
+    uint64_t elastic_keep = 512ull << 20;
+    uint64_t session_fixed = 768ull << 20;
+    uint64_t spill_margin = 128ull << 20;
+    bool custom = false;   ///< any of them was set by the environment
+};
+const Reserves& reserves();
+
+}  // namespace basalt::models::inkling2::ink
