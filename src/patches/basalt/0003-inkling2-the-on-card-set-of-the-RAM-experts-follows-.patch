@@ -9,10 +9,30 @@
 //   BASALT_INK_PROFILE_OUT        a file a session writes decode's routing counts to as an expert profile, the most
 //                                 routed pair first (--expert-profile reads it): when the session ends and every
 //   BASALT_INK_PROFILE_EVERY      decoded tokens (default 4096; 0: at the end only)
+//
+//   BASALT_INK_ADAPT=1            the on-card set of the RAM experts follows the conversation (one session, a spill):
+//                                 every
+//   BASALT_INK_ADAPT_INTERVAL     decoded tokens (64) a round adds decode's lookups since the last round to each RAM
+//                                 expert's score, orders the RAM experts by score (the elastic spill's copy-back and
+//                                 its way back to RAM follow that order from then on), gives the card buffers of the
+//                                 coldest ones to the hottest without one, and multiplies the scores by
+//   BASALT_INK_ADAPT_DECAY        (0.95). At most
+//   BASALT_INK_ADAPT_SWAPS        buffers change hands a round (48), each only when the hot score is above the cold
+//                                 one's times
+//   BASALT_INK_ADAPT_RATIO        (1.25) plus
+//   BASALT_INK_ADAPT_FLOOR        lookups (2)
+//   BASALT_INK_ADAPT_RERANK=0     keeps the profile's order and swaps nothing (the top-up below still runs)
+//   BASALT_INK_DECODE_KEEP_MIB    with ADAPT: a round also copies the hottest RAM experts without a card buffer to the
+//                                 card while this much of it stays free (0, the default: no such copies), at most
+//   BASALT_INK_ADAPT_FILLS        a round (256). Before a prompt is read those copies go back, all of them or, with
+//   BASALT_INK_PROMPT_KEEP_MIB    set, only until this much is free
+//   BASALT_INK_ADAPT_LOG=1        a log line for every round (default: for the rounds that moved something)
 #pragma once
 
 #include <cstdint>
 #include <string>
+#include <utility>
+#include <vector>
 
 namespace basalt::models::inkling2::ink {
 
@@ -40,4 +60,36 @@ struct ProfileOut {
 };
 const ProfileOut& profile_out();
 
+/// The adaptive on-card set.
+struct Adapt {
+    bool on = false;
+    long long interval = 64;    ///< decoded tokens between two rounds
+    int swaps = 48;             ///< card buffers that change hands a round
+    int fills = 256;            ///< new card copies a round
+    double decay = 0.95;        ///< a score's factor each round
+    double ratio = 1.25;        ///< a swap needs hot > cold * ratio + floor
+    double floor = 2.0;
+    bool rerank = true;         ///< the RAM experts' order follows the scores
+    uint64_t decode_keep = 0;   ///< bytes the top-up leaves free (0: no top-up)
+    uint64_t prompt_keep = 0;   ///< bytes free before a prompt, when only part of the top-up should go (0: all of it goes)
+    bool log_all = false;
+};
+const Adapt& adapt();
+
+/// Orders the RAM experts by `score` (index layer * n_expert + expert), the highest first; ties keep their order (the
+/// profile's at first).
+void rerank(std::vector<std::pair<int32_t, int32_t>>& order, int n_expert, const std::vector<double>& score);
+
+/// Pair `in` (no card buffer) takes the card buffer of pair `out`; both are indexes layer * n_expert + expert.
+struct Swap {
+    int32_t in = 0, out = 0;
+};
+/// A round's swaps: the hottest RAM experts without a card buffer, each for the coldest holder left whose buffer fits it,
+/// while its score is above that holder's times `ratio` plus `floor`; `max_swaps` at most. `order`: the RAM experts by
+/// score, the highest first (rerank). `cap`: the bytes of the card buffer each pair holds (0: none); `need`: each pair's
+/// blob bytes. No pair is in two swaps.
+std::vector<Swap> plan_swaps(const std::vector<std::pair<int32_t, int32_t>>& order, int n_expert, const std::vector<double>& score,
+                             const std::vector<uint64_t>& cap, const std::vector<uint64_t>& need, int max_swaps, double ratio,
+                             double floor);
+
 }  // namespace basalt::models::inkling2::ink
diff --git a/src/models/inkling2/ink_test.cpp b/src/models/inkling2/ink_test.cpp
new file mode 100644
index 0000000..2e6484b
--- /dev/null
+++ b/src/models/inkling2/ink_test.cpp
@@ -0,0 +1,147 @@
+// src/models/inkling2/ink_test.cpp - the adaptive on-card set's choices (ink.hpp): the order follows the scores and keeps
+// ties where they were, a round swaps the hottest RAM experts without a card buffer for the coldest ones with one, only
+// when the gain clears the hysteresis, never into a buffer that is too small, and a second round over the same scores
+// has nothing left to do.
+#include "models/inkling2/ink.hpp"
+
+#include <cstdio>
+#include <set>
+#include <vector>
+
+using namespace basalt::models::inkling2;
+
+namespace {
+int failures = 0;
+void expect(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL %s\n", what);
+        ++failures;
+    }
+}
+using Order = std::vector<std::pair<int32_t, int32_t>>;
+
+// applies the swaps to the caps: `in` takes the buffer of `out`
+void apply(const std::vector<ink::Swap>& swaps, std::vector<uint64_t>& cap) {
+    for (const ink::Swap& s : swaps) {
+        cap[(size_t) s.in] = cap[(size_t) s.out];
+        cap[(size_t) s.out] = 0;
+    }
+}
+double held_score(const std::vector<uint64_t>& cap, const std::vector<double>& score) {
+    double v = 0;
+    for (size_t i = 0; i < cap.size(); ++i)
+        if (cap[i]) v += score[i];
+    return v;
+}
+}  // namespace
+
+int main() {
+    const int NE = 8;   // experts a layer; pair index = layer * NE + expert
+    // ---- the order
+    {
+        Order order = {{0, 0}, {0, 1}, {1, 2}, {1, 3}, {0, 4}};
+        std::vector<double> score((size_t) 2 * NE, 0.0);
+        score[(size_t) 1 * NE + 3] = 9;   // (1,3) hottest
+        score[(size_t) 0 * NE + 4] = 5;   // then (0,4)
+        ink::rerank(order, NE, score);
+        const Order want = {{1, 3}, {0, 4}, {0, 0}, {0, 1}, {1, 2}};
+        expect(order == want, "the order follows the scores; ties keep their order");
+        ink::rerank(order, NE, score);
+        expect(order == want, "ranking twice changes nothing");
+    }
+    // ---- the swaps: one layer, eight RAM experts in profile order 0..7; 0..2 hold a card copy
+    const uint64_t S = 4479120;
+    Order order;
+    for (int e = 0; e < NE; ++e) order.emplace_back(0, e);
+    std::vector<uint64_t> need((size_t) NE, S), cap((size_t) NE, 0);
+    cap[0] = cap[1] = cap[2] = S;
+    {
+        std::vector<double> score((size_t) NE, 0.0);
+        expect(ink::plan_swaps(order, NE, score, cap, need, 8, 1.25, 1.0).empty(), "no lookups, no swaps");
+    }
+    {
+        // the conversation routes 5, 6, 7 and the copy 1; copies 0 and 2 are idle
+        std::vector<double> score = {0, 40, 0, 0, 0, 30, 20, 10};
+        Order o = order;
+        ink::rerank(o, NE, score);
+        const std::vector<ink::Swap> sw = ink::plan_swaps(o, NE, score, cap, need, 8, 1.25, 1.0);
+        expect(sw.size() == 2, "two idle copies, two swaps");
+        expect(sw.size() == 2 && sw[0].in == 5 && sw[1].in == 6, "the hottest without a buffer come in first");
+        std::set<int32_t> outs;
+        for (const ink::Swap& s : sw) outs.insert(s.out);
+        expect(outs == std::set<int32_t>{0, 2}, "the idle copies go, the routed one stays");
+        std::vector<uint64_t> c2 = cap;
+        const double before = held_score(c2, score);
+        apply(sw, c2);
+        expect(held_score(c2, score) > before, "the card's share of the lookups grows");
+        expect(ink::plan_swaps(o, NE, score, c2, need, 8, 1.25, 1.0).empty(), "a second round over the same scores has nothing to do");
+        // bounded
+        expect(ink::plan_swaps(o, NE, score, cap, need, 1, 1.25, 1.0).size() == 1, "the round's bound holds");
+        expect(ink::plan_swaps(o, NE, score, cap, need, 0, 1.25, 1.0).empty(), "a bound of zero: none");
+    }
+    {
+        // hysteresis: 5 is only a little hotter than the coldest copy
+        std::vector<double> score = {100, 100, 20, 0, 0, 22, 0, 0};
+        Order o = order;
+        ink::rerank(o, NE, score);
+        expect(ink::plan_swaps(o, NE, score, cap, need, 8, 1.25, 1.0).empty(), "a gain inside the ratio: no swap");
+        expect(ink::plan_swaps(o, NE, score, cap, need, 8, 1.0, 1.0).size() == 1, "the same gain with no ratio: one swap");
+        expect(ink::plan_swaps(o, NE, score, cap, need, 8, 1.0, 5.0).empty(), "the floor counts too");
+    }
+    {
+        // sizes: two layers of different strides; a large blob does not take a small buffer but takes a large one
+        const int L = 2;
+        Order o2;
+        for (int l = 0; l < L; ++l)
+            for (int e = 0; e < NE; ++e) o2.emplace_back(l, e);
+        std::vector<uint64_t> need2((size_t) L * NE), cap2((size_t) L * NE, 0);
+        for (int e = 0; e < NE; ++e) need2[(size_t) e] = S, need2[(size_t) NE + e] = 2 * S;
+        cap2[0] = S;                  // (0,0): a small buffer, idle
+        cap2[(size_t) NE + 1] = 2 * S;   // (1,1): a large buffer, idle
+        cap2[(size_t) NE + 2] = 2 * S;   // (1,2): a large buffer, routed a little
+        std::vector<double> score((size_t) L * NE, 0.0);
+        score[(size_t) NE + 5] = 50;   // large, hot
+        score[(size_t) 3] = 40;        // small, hot
+        score[(size_t) NE + 6] = 30;   // large, hot
+        score[(size_t) NE + 2] = 4;
+        ink::rerank(o2, NE, score);
+        const std::vector<ink::Swap> sw = ink::plan_swaps(o2, NE, score, cap2, need2, 8, 1.25, 1.0);
+        bool fits = true;
+        std::set<int32_t> ins, outs;
+        for (const ink::Swap& s : sw) {
+            fits = fits && need2[(size_t) s.in] <= cap2[(size_t) s.out] && cap2[(size_t) s.in] == 0 && cap2[(size_t) s.out] != 0;
+            ins.insert(s.in);
+            outs.insert(s.out);
+        }
+        expect(fits, "every swap fits its buffer, moves one without a buffer in and one with a buffer out");
+        expect(ins.size() == sw.size() && outs.size() == sw.size(), "no pair swaps twice in a round");
+        expect(sw.size() == 3, "each hot blob finds a buffer of its size");
+        expect(ins.count(NE + 5) && ins.count(3) && ins.count(NE + 6), "the three hot ones come in");
+        std::vector<uint64_t> c3 = cap2;
+        apply(sw, c3);
+        expect(c3[(size_t) NE + 5] == 2 * S && c3[(size_t) 3] != 0, "the large blob holds a large buffer afterwards");
+        expect(ink::plan_swaps(o2, NE, score, c3, need2, 8, 1.25, 1.0).empty(), "and the next round rests");
+    }
+    {
+        // a hot large blob with only small idle buffers: it stays out, and a small one behind it still gets its swap
+        const int L = 2;
+        Order o2;
+        for (int l = 0; l < L; ++l)
+            for (int e = 0; e < NE; ++e) o2.emplace_back(l, e);
+        std::vector<uint64_t> need2((size_t) L * NE), cap2((size_t) L * NE, 0);
+        for (int e = 0; e < NE; ++e) need2[(size_t) e] = S, need2[(size_t) NE + e] = 2 * S;
+        cap2[0] = S;
+        std::vector<double> score((size_t) L * NE, 0.0);
+        score[(size_t) NE + 5] = 50;
+        score[(size_t) 3] = 40;
+        ink::rerank(o2, NE, score);
+        const std::vector<ink::Swap> sw = ink::plan_swaps(o2, NE, score, cap2, need2, 8, 1.25, 1.0);
+        expect(sw.size() == 1 && sw[0].in == 3 && sw[0].out == 0, "a blob too large for every idle buffer is passed over");
+    }
+    // ---- the settings' readers
+    expect(ink::env_int("BASALT_INK_TEST_UNSET_VARIABLE", 7, 0, 10) == 7, "an unset variable gives the default");
+    expect(ink::env_real("BASALT_INK_TEST_UNSET_VARIABLE", 0.5, 0, 1) == 0.5, "and for a real number");
+    if (failures) return 1;
+    std::printf("inkling2 ink: ok\n");
+    return 0;
+}
diff --git a/src/models/inkling2/model.cpp b/src/models/inkling2/model.cpp
index ac65ff8..e6e1d46 100644
--- a/src/models/inkling2/model.cpp
+++ b/src/models/inkling2/model.cpp
@@ -396,6 +396,7 @@ model::Result InklingModel::load_experts(core::LoadPlan& reads, int file, uint64
         copy_.assign((size_t) g.n_layers * g.n_expert, nullptr);
         layer_copies_.assign((size_t) g.n_layers, 0);
         host_addr_.assign((size_t) g.n_layers * g.n_expert, 0);
+        card_addr_.assign((size_t) g.n_layers * g.n_expert, 0);
     }
     // the RAM copies, every spilled layer's in slot order, and the staging their ranges share
     std::vector<uint64_t> host_at((size_t) g.n_layers, 0);
@@ -585,4 +586,95 @@ uint64_t InklingModel::demote(uint64_t bytes, void* stream) {
     return freed;
 }
 
+// ---- BASALT_INK_ADAPT (ink.hpp)
+
+const uint8_t* InklingModel::ram_blob(size_t i) const {
+    const int ne = geo().n_expert;
+    const size_t l = i / (size_t) ne, e = i % (size_t) ne;
+    const LayerWeights& w = layers_[l];
+    return w.spill_host + (uint64_t) (spill_.slot[l][e] - (ne - w.n_spill)) * w.expert_stride;
+}
+
+bool InklingModel::ink_entry(size_t i, const unsigned long long* at, void* stream) {
+    const int ne = geo().n_expert;
+    return cudaMemcpyAsync(layers_[i / (size_t) ne].blob_table + i % (size_t) ne, at, 8, cudaMemcpyHostToDevice, (cudaStream_t) stream) ==
+           cudaSuccess;
+}
+
+InklingModel::InkRound InklingModel::ink_round(const std::vector<double>& score, const ink::Adapt& a, void* stream) {
+    InkRound out;
+    const int ne = geo().n_expert;
+    if (spill_order_.empty() || score.size() != copy_.size()) return out;
+    const cudaStream_t st = (cudaStream_t) stream;
+    if (a.rerank) ink::rerank(spill_order_, ne, score);
+    // a pair's blob into a card buffer and its table entry to that buffer, in this order on the stream
+    const auto load = [&](size_t i, void* buf) {
+        card_addr_[i] = (unsigned long long) buf;
+        return cudaMemcpyAsync(buf, ram_blob(i), layers_[i / (size_t) ne].expert_stride, cudaMemcpyHostToDevice, st) == cudaSuccess &&
+               ink_entry(i, &card_addr_[i], stream);
+    };
+    // the top-up: new copies of the hottest RAM experts without a card buffer, while the card keeps decode_keep free
+    if (a.decode_keep > 0) {
+        for (const auto& [l, e] : spill_order_) {
+            if (out.filled >= a.fills) break;
+            const size_t i = (size_t) l * ne + e;
+            if (copy_[i]) continue;
+            const uint64_t stride = layers_[(size_t) l].expert_stride;
+            size_t free_b = 0, total_b = 0;
+            cudaMemGetInfo(&free_b, &total_b);
+            if (free_b < a.decode_keep + stride) break;
+            void* p = nullptr;
+            if (cudaMalloc(&p, stride) != cudaSuccess) {
+                cudaGetLastError();
+                break;
+            }
+            if (!load(i, p)) {
+                ink_entry(i, &host_addr_[i], stream);
+                cudaStreamSynchronize(st);
+                cudaFree(p);
+                out.failed = true;
+                break;
+            }
+            copy_[i] = p;
+            ++n_copy_;
+            ++layer_copies_[(size_t) l];
+            ++out.filled;
+            out.copied += stride;
+        }
+    }
+    // the swaps: a buffer's bytes are counted as its holder's stride (never more than it has)
+    if (a.rerank && a.swaps > 0 && !out.failed) {
+        std::vector<uint64_t> cap(copy_.size(), 0), need(copy_.size(), 0);
+        for (const auto& [l, e] : spill_order_) {
+            const size_t i = (size_t) l * ne + e;
+            need[i] = layers_[(size_t) l].expert_stride;
+            if (copy_[i]) cap[i] = need[i];
+        }
+        for (const ink::Swap& s : ink::plan_swaps(spill_order_, ne, score, cap, need, a.swaps, a.ratio, a.floor)) {
