diff --git a/src/models/inkling2/ink.cpp b/src/models/inkling2/ink.cpp
index 820e00e..ed56f35 100644
--- a/src/models/inkling2/ink.cpp
+++ b/src/models/inkling2/ink.cpp
@@ -57,4 +57,59 @@ const ProfileOut& profile_out() {
     return p;
 }
 
+const Adapt& adapt() {
+    static const Adapt a = [] {
+        Adapt v;
+        v.on = env_int("BASALT_INK_ADAPT", 0, 0, 1) != 0;
+        v.interval = env_int("BASALT_INK_ADAPT_INTERVAL", v.interval, 1, 1ll << 40);
+        v.swaps = (int) env_int("BASALT_INK_ADAPT_SWAPS", v.swaps, 0, 1 << 20);
+        v.fills = (int) env_int("BASALT_INK_ADAPT_FILLS", v.fills, 0, 1 << 20);
+        v.decay = env_real("BASALT_INK_ADAPT_DECAY", v.decay, 0.0, 1.0);
+        v.ratio = env_real("BASALT_INK_ADAPT_RATIO", v.ratio, 1.0, 1e6);
+        v.floor = env_real("BASALT_INK_ADAPT_FLOOR", v.floor, 0.0, 1e12);
+        v.rerank = env_int("BASALT_INK_ADAPT_RERANK", 1, 0, 1) != 0;
+        v.decode_keep = (uint64_t) env_int("BASALT_INK_DECODE_KEEP_MIB", 0, 0, 65536) << 20;
+        v.prompt_keep = (uint64_t) env_int("BASALT_INK_PROMPT_KEEP_MIB", 0, 0, 65536) << 20;
+        v.log_all = env_int("BASALT_INK_ADAPT_LOG", 0, 0, 1) != 0;
+        return v;
+    }();
+    return a;
+}
+
+void rerank(std::vector<std::pair<int32_t, int32_t>>& order, int n_expert, const std::vector<double>& score) {
+    const auto at = [&](const std::pair<int32_t, int32_t>& p) { return score[(size_t) p.first * (size_t) n_expert + (size_t) p.second]; };
+    std::stable_sort(order.begin(), order.end(), [&](const auto& a, const auto& b) { return at(a) > at(b); });
+}
+
+std::vector<Swap> plan_swaps(const std::vector<std::pair<int32_t, int32_t>>& order, int n_expert, const std::vector<double>& score,
+                             const std::vector<uint64_t>& cap, const std::vector<uint64_t>& need, int max_swaps, double ratio,
+                             double floor) {
+    std::vector<Swap> out;
+    if (max_swaps <= 0) return out;
+    const auto index = [&](const std::pair<int32_t, int32_t>& p) { return (int32_t) (p.first * n_expert + p.second); };
+    // the holders, the coldest first
+    std::vector<int32_t> cold;
+    for (auto it = order.rbegin(); it != order.rend(); ++it)
+        if (cap[(size_t) index(*it)]) cold.push_back(index(*it));
+    std::vector<uint8_t> used(cold.size(), 0);
+    const auto worth = [&](int32_t hot, int32_t holder) { return score[(size_t) hot] > score[(size_t) holder] * ratio + floor; };
+    size_t c0 = 0;   // the coldest holder not yet in a swap
+    for (const auto& p : order) {
+        if ((int) out.size() >= max_swaps) break;
+        const int32_t hot = index(p);
+        if (cap[(size_t) hot]) continue;
+        while (c0 < cold.size() && used[c0]) ++c0;
+        // the pairs after this one are no hotter and the holders left no colder: when this one is not worth it, none is
+        if (c0 == cold.size() || !worth(hot, cold[c0])) break;
+        for (size_t c = c0; c < cold.size(); ++c) {
+            if (used[c] || cap[(size_t) cold[c]] < need[(size_t) hot]) continue;
+            if (!worth(hot, cold[c])) break;
+            used[c] = 1;
+            out.push_back({hot, cold[c]});
+            break;
+        }
+    }
+    return out;
+}
+
 }  // namespace basalt::models::inkling2::ink
