+// The staging as slots: every spilled layer's range ends in a tail mapped over the shared staging from its first byte, so
+// the range with the longest tail shows all of it as one run of addresses. Decode reads no byte of it (a kept expert's
+// slot lies in the range's own backing, a RAM expert is read at its RAM address or its card copy); the prompt path
+// writes every byte of it that it reads, chunk by chunk.
+bool InklingModel::ink_stage_init() {
+    if (stage_base_) return true;
+    if (stage_tried_) return false;
+    stage_tried_ = true;
+    uint8_t* base = nullptr;
+    uint64_t tail = 0, slot = 0;
+    for (const Range& r : ranges_)
+        if (r.bytes - r.own > tail) {
+            tail = r.bytes - r.own;
+            base = r.va + r.own;
+        }
+    for (const LayerWeights& w : layers_)
+        if (w.n_spill) slot = std::max<uint64_t>(slot, w.expert_stride);
+    if (!base || !slot || tail < slot || tail > (uint64_t) staging_.size() * core::vmm::granularity()) return false;
+    stage_slot_ = slot;
+    stage_owner_.assign((size_t) (tail / slot), -1);
+    stage_at_.assign(copy_.size(), -1);
+    stage_base_ = base;
+    basalt::log::info("basalt inkling2", "ink: the prompt staging holds RAM experts during decode: %lld slots of %.2f MiB (%.2f GiB)",
+                      (long long) stage_owner_.size(), (double) slot / (double) (1ull << 20), (double) tail / (double) kGiB);
+    return true;
+}
+
+int InklingModel::ink_release_staging(void* stream) {
+    if (n_staged_ == 0) return 0;
+    int n = 0;
+    bool ok = true;
+    for (size_t s = 0; s < stage_owner_.size(); ++s) {
+        const int32_t i = stage_owner_[s];
+        if (i < 0) continue;
+        ok = ink_entry((size_t) i, &host_addr_[(size_t) i], stream) && ok;
+        stage_at_[(size_t) i] = -1;
+        stage_owner_[s] = -1;
+        ++n;
+    }
+    n_staged_ = 0;
+    if (cudaStreamSynchronize((cudaStream_t) stream) != cudaSuccess) ok = false;
+    if (!ok) cudaGetLastError();
+    return ok ? n : -1;
+}
+
 }  // namespace basalt::models::inkling2
